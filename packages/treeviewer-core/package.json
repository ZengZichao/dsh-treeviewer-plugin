{
  "name": "treeviewer-core",
  "version": "0.1.0",
  "description": "Node adapter for the TreeViewerCommandLine REPL: process control, option-schema introspection and image export.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "samples/"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "treeviewer",
    "phylogenetics",
    "command-line",
    "adapter"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  }
}
